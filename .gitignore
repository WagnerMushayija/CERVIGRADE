# Datasets: large, not code, and not something GitHub is meant to store.
# Anyone cloning the repo re-downloads or re-generates these instead.
data/raw/
data/processed/

# Trained model weights: also large binary files, regenerated by re-running training.
models/*.pt
models/*.pth
models/*.h5
models/*.onnx
models/*.keras

# Python noise
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
.venv/

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/

# Only the current proposal from docs/ is tracked; earlier drafts stay local
docs/Literature_Review_1-10.docx
docs/Literature_Review_1-15.docx
docs/Presentation_Flow.docx

# Files moved aside, waiting to be deleted by hand
_to_delete/

# Saved records, uploaded images and the login signing key from the running app
app_data/
